# Copy to .env.local and fill in. Never commit real values.

# ConvertKit — newsletter + automated sequences
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# PayFast — one-time checkout (ZAR). No recurring billing; there is no subscription.
# Leave these blank and the Buy Now button stays hidden — the site falls back to
# WhatsApp ordering rather than showing a checkout that cannot work.
#
# PayFast's public sandbox test credentials (safe to use, documented by PayFast):
#   PAYFAST_MERCHANT_ID=10000100
#   PAYFAST_MERCHANT_KEY=46f0cd694581a
#   PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Set this in the PayFast dashboard first, then copy it here. It must match
# exactly or every signature fails.
PAYFAST_PASSPHRASE=
# "false" switches to live payments. Anything else stays on sandbox.
PAYFAST_SANDBOX=true

# Supabase — accounts, memberships, orders, rewards
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner notifications
OWNER_NOTIFICATION_EMAIL=

# Public site URL, used for PayFast return/notify URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
