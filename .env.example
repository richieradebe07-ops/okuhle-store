# Copy to .env.local and fill in. Never commit real values.

# Resend — transactional email AND marketing broadcasts (one account, one domain).
#
# ⚠️ THE API KEY IS CREATED BY A HUMAN in the Resend dashboard and pasted here.
#    It goes in environment variables ONLY — never in code, never committed.
#    If it ever lands in a commit, REVOKE it in Resend and generate a new one;
#    deleting the line is not enough.
#
# ⚠️ FROM_EMAIL must be on a domain you own and have verified in Resend (SPF,
#    DKIM and DMARC records at your registrar). Gmail addresses cannot be
#    verified as senders — nobody can add DNS records to gmail.com. A Gmail
#    address works fine as the RECIPIENT for owner alerts.
#
# ⚠️ Resend's free tier is 100 emails/DAY. Each order sends 2 (customer +
#    owner), so that is ~50 orders/day. Upgrade before Black Friday.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
FROM_EMAIL=orders@okuhle.co.za
FROM_NAME=OHY Okuhle
OWNER_EMAIL=ohy.okuhle@gmail.com

# PayFast — one-time checkout (ZAR). No recurring billing; there is no subscription.
# Leave these blank and the Buy Now button stays hidden — the site falls back to
# WhatsApp ordering rather than showing a checkout that cannot work.
#
# PayFast's public sandbox test credentials (safe to use, documented by PayFast):
#   PAYFAST_MERCHANT_ID=10000100
#   PAYFAST_MERCHANT_KEY=46f0cd694581a
#   PAYFAST_PASSPHRASE=jt7NOE43FZPn
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Set this in the PayFast dashboard first, then copy it here. It must match
# exactly or every signature fails.
PAYFAST_PASSPHRASE=
# "false" switches to live payments. Anything else stays on sandbox.
PAYFAST_SANDBOX=true

# Supabase — accounts, memberships, orders, rewards
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for PayFast return/notify URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
