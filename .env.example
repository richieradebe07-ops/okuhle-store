# Copy to .env.local and fill in. Never commit real values.

# ConvertKit — newsletter + automated sequences
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# PayFast — one-time checkout and Okuhle+ recurring billing (ZAR)
# Use the sandbox credentials until live testing is done.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Supabase — accounts, memberships, orders, rewards
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner notifications
OWNER_NOTIFICATION_EMAIL=

# Public site URL, used for PayFast return/notify URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
